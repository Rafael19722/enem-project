# Porta do servidor (Render injeta a sua própria PORT em produção)
PORT=5000

# Origens permitidas no CORS, separadas por vírgula
# Ex.: https://seu-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Base da API pública do ENEM
ENEM_API_URL=https://api.enem.dev/v1

# Postgres do espelho local (docker-compose.yml na raiz sobe um em 5433)
DATABASE_URL=postgresql://enem:enem@localhost:5433/enem
